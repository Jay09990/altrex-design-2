                          <h4 className="text-sm font-semibold text-[var(--text-primary)]">
                            Message Throughput
                          </h4>

                          <p className="mt-0.5 text-xs text-[var(--text-secondary)]">
                            Live infrastructure analytics
                          </p>
                        </div>

