                  whileHover={{
                    scale: 1.08,
                    rotate: 5,
                  }}
                  className="flex h-9 w-9 items-center justify-center rounded-lg bg-gradient-to-br from-violet-600 to-fuchsia-600 shadow-md shadow-violet-300"
                >
                  <Zap className="h-4 w-4 text-white" />
