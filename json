                          icon: Globe,
                          label: "Global Regions",
                          value: "120+",
                          change: "+24%",
                          iconBg: "from-cyan-600 to-cyan-500",
                          iconShadow: "shadow-cyan-200",
                          cardBg: "bg-[var(--bg-surface)]/80",
                          border: "border-white/10",
                          blob: "bg-cyan-400",
