                      ].map(
                        (
                          {
                            icon: Icon,
                            label,
                            value,
                            change,
                            iconBg,
                            iconShadow,
                            cardBg,
                            border,
                            blob,
                          },
                          i,
                        ) => (
                          <motion.div
                            key={i}
                            whileHover={{
