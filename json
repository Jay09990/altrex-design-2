              Altrex Digital Platforms Pvt Ltd
            </p>
          </div>
        </div>

        <nav className="hidden items-center gap-8 lg:flex">
          {navLinks.map((item) => (
            <Link key={item.name} to={item.href} className="text-sm font-medium">
